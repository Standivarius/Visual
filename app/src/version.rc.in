#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VISUAL_VERSION_MAJOR@,@VISUAL_VERSION_MINOR@,@VISUAL_VERSION_PATCH@,0
 PRODUCTVERSION @VISUAL_VERSION_MAJOR@,@VISUAL_VERSION_MINOR@,@VISUAL_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS @VISUAL_VERSION_FILEFLAGS@
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Standivarius\0"
            VALUE "FileDescription", "Visual low-vision magnification software\0"
            VALUE "FileVersion", "@VISUAL_VERSION_SEMVER@\0"
            VALUE "InternalName", "Visual\0"
            VALUE "ProductName", "Visual\0"
            VALUE "ProductVersion", "@VISUAL_VERSION_SEMVER@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
